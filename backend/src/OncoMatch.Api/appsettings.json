{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Match": {
    "Inference": {
      "Route": "native",
      "BaseUrl": "http://localhost:11434",
      "NativeModel": "gpt-oss:20b",
      "OpenAiCompatibleModel": "oncomatch-gpt-oss-20b-openai-compatible:latest",
      "RequestTimeoutSeconds": 600
    }
  }
}
