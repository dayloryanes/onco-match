                                                                                      "description":  "Patients will be injected with 18F-FDG and PET imaging was performed",
                                                                                      "armGroupLabels":  [
                                                                                                             "68Ga-FL-031 Group"
                                                                                                         ]
                                                                                  }
                                                                              ]
                                                        },
